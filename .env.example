# Copy to `.env` and fill in. `.env` is in .gitignore.
# Vertex AI on your GCP project:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east4

# Model name (REQUIRED — no hard-coded fallback in code).
# On Vertex AI you need a fully-qualified versioned name; AI Studio
# shorthands like `gemini-flash-latest` 404 on regional endpoints.
#
# Current recommendation (May 2026): gemini-3-flash-preview — ~3x faster
# and +15% accuracy over 2.5-flash, modest cost premium ($0.50/$3.00 vs
# $0.30/$2.50 per 1M tokens). Note: gemini-2.5-flash retires no earlier
# than Oct 16, 2026, so migration is a near-term certainty either way.
#
# Region note: preview models sometimes only ship to the `global`
# endpoint. If the preview 404s on your region, set
# GOOGLE_CLOUD_LOCATION=global above.
#
# Alternatives:
#   gemini-2.5-flash       — stable production, cheapest, retiring Oct 2026
#   gemini-3-pro-preview   — heavier reasoning, more expensive
#   gemini-3.5-flash       — newest (May 19 2026), $1.50/$9.00 per 1M
E2E_AGENT_MODEL=gemini-3-flash-preview

# Alternative auth (AI Studio key; remove the three GOOGLE_* lines above if using this):
# GOOGLE_API_KEY=...
