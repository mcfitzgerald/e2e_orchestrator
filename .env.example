# Copy to `.env` and fill in. `.env` is in .gitignore.
# Vertex AI on your GCP project:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east4

# Model name. On Vertex AI you need a fully-qualified versioned name —
# `gemini-flash-latest` is an AI Studio shorthand and will 404 on Vertex.
# Safe Vertex defaults: gemini-2.5-flash (fast/cheap), gemini-2.5-pro (heavier).
E2E_AGENT_MODEL=gemini-2.5-flash

# Alternative auth (AI Studio key; remove the three GOOGLE_* lines above if using this):
# GOOGLE_API_KEY=...
