# Copy to `.env` and fill in. `.env` is in .gitignore.
# Vertex AI (a.k.a. Gemini Enterprise Agent Platform) on your GCP project:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Use `global` for the newest GA models. Regional endpoints (e.g. us-east4)
# lag on model availability — gemini-3.5-flash 404s on us-east4 for our project
# but resolves on `global`. (Verified 2026-05-31.)
GOOGLE_CLOUD_LOCATION=global

# Model name (REQUIRED — no hard-coded fallback in code).
# On Vertex AI you need a fully-qualified, *available* model name; AI Studio
# shorthands like `gemini-flash-latest` 404 on regional endpoints.
#
# Current recommendation (2026-05-31): gemini-3.5-flash — GA since 2026-05-19,
# broadly available, and (unlike a preview) won't vanish from an endpoint.
# Requires GOOGLE_CLOUD_LOCATION=global on our project. ~$1.50/$9.00 per 1M
# input/output tokens ($1.65/$9.90 on non-global regions).
#
# DO NOT use gemini-3-flash-preview: it is Pre-GA and 404s on this project
# (not available on us-east4 or global as tested 2026-05-31). Preview model
# availability is volatile and region-gated.
#
# Alternatives:
#   gemini-2.5-flash  — GA, cheapest, what Phases 2-5 actually ran on; retiring
#                       ~Oct 2026. Works on regional endpoints (e.g. us-east4).
#   gemini-3-pro-preview — heavier reasoning; preview, same availability caveats.
E2E_AGENT_MODEL=gemini-3.5-flash

# Runaway-loop trips (deterministic, in-code — billing lags ~a day, so these are
# the real cost protection). Defaults are loose tripwires for genuine runaway,
# sized above the heaviest observed legit run; tighten as you learn the workload.
# A trip emits a `runaway_guard_tripped` event and halts the run.
# E2E_MAX_LLM_CALLS=50        # per single agent invocation (ADK default is 500)
# E2E_MAX_INVOCATIONS=25      # total agent invocations per run (catches flow loops)
# E2E_MAX_RUN_TOKENS=2000000  # cumulative tokens per run (~$3; direct cost cap)

# Alternative auth (Gemini Developer API / AI Studio key; remove the three
# GOOGLE_* lines above if using this — no region gating, simplest for throwaway
# local iteration, but not the enterprise/Vertex deployment path):
# GOOGLE_GENAI_USE_VERTEXAI=0
# GOOGLE_API_KEY=...
